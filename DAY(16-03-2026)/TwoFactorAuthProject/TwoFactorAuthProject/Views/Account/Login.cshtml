
@model TwoFactorAuthProject.ViewModels.LoginViewModel

<h2>Login</h2>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label>Email</label>
        <input type="email" asp-for="Email" class="form-control" placeholder="Email" />
    </div>
    <div class="form-group">
        <label>Password</label>
        <input type="password" asp-for="Password" class="form-control" placeholder="Password" />
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="RememberMe" /> Remember me
    </div>
    <button type="submit" class="btn btn-primary">Login</button>
</form>